<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILD ONLY (merged into the debug variant, never into release). Lets a debug build download
  the models over plain http from a test server on the development machine (emulator: 10.0.2.2) or
  in-process (127.0.0.1): scripts/model_test_server.py with -PpalayaModelBaseUrl, and FaultHttpServer
  in the instrumented tests (docs/MODEL_DOWNLOAD_DESIGN.md §6.3). The main manifest has no
  networkSecurityConfig and no usesCleartextTraffic (ManifestPermissionsTest asserts both), so a
  release build gets the platform default: no cleartext at all.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>

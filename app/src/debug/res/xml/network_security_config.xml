<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILD ONLY (app/src/debug). Cleartext is refused everywhere except the three loopback names a
  local test server answers on: the emulator's alias for the host machine and the device's own loopback.
  ModelDownloader applies the same rule itself (and only in a debug build). See src/debug/AndroidManifest.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET and ACCESS_NETWORK_STATE (D2b, docs/MODEL_DOWNLOAD_DESIGN.md): the Stockfish net and the
      narration voice are no longer in the APK. They are downloaded ONCE, from the app's GitHub release,
      only after the user taps Download on the Setup screen (ACCESS_NETWORK_STATE: the "you're on mobile
      data" check before it), and afterwards the app is fully offline; the only other network use is a
      manual "Check for updates". No program code is ever downloaded. One class opens connections
      (data/models/ModelDownloader.kt; NetworkCallSitesTest), https only. Cleartext is NOT enabled here:
      only the debug build's network security config (src/debug) allows http, to the local test server.
      ManifestPermissionsTest (host) and NetworkPermissionTest (instrumented) pin the exact set.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Video export runs in VideoExportService, a started foreground service, so it survives the
      user leaving the video screen or backgrounding the app (a full review takes many minutes).

      Typed-FGS rules (Android 14+): the service must declare a foregroundServiceType AND hold the
      matching typed permission, or startForeground() throws. The service declares BOTH types and
      picks one at runtime (ExportForegroundServiceType): `mediaProcessing` on API 35+ (Android 15
      added it for exactly this, transcoding/encoding media), `dataSync` on API 29-34 where
      mediaProcessing does not exist. Both carry Android 15's 6-hour limit; the service implements
      onTimeout to stop cleanly.

      POST_NOTIFICATIONS is a runtime permission from API 33. It is requested opportunistically
      and the export never depends on it: denying it only hides the progress notification, the
      foreground service still runs to completion.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ChessAnalyzerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.ChessAnalyzer"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.ChessAnalyzer">

            <!-- App launcher entry -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- chess.com / Lichess "Share" -> plain text PGN -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Share of one or more PGN-ish files -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-chess-pgn" />
                <data android:mimeType="application/vnd.chess-pgn" />
                <data android:mimeType="text/x-chess-pgn" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-chess-pgn" />
                <data android:mimeType="application/vnd.chess-pgn" />
                <data android:mimeType="text/x-chess-pgn" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Opening a .pgn file from a file manager / Downloads / another app -->
            <intent-filter android:label="@string/open_pgn_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/x-chess-pgn" />
                <data android:scheme="content" android:mimeType="application/vnd.chess-pgn" />
                <data android:scheme="content" android:mimeType="text/x-chess-pgn" />
                <data android:scheme="file" android:mimeType="application/x-chess-pgn" />
                <data android:scheme="file" android:mimeType="application/vnd.chess-pgn" />
                <data android:scheme="file" android:mimeType="text/x-chess-pgn" />
            </intent-filter>

            <!-- Fallback: raw file:// / content:// URI ending in .pgn without a registered mime type -->
            <intent-filter android:label="@string/open_pgn_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="file"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.pgn" />
            </intent-filter>
            <intent-filter android:label="@string/open_pgn_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.pgn" />
            </intent-filter>
        </activity>

        <!-- Owns the MP4 export coroutine outside any Activity/composition. Both types are declared;
             the one passed to startForeground() is chosen by SDK level (see the permission block). -->
        <service
            android:name=".video.VideoExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <!-- D2c: the one-time model download (docs/MODEL_DOWNLOAD_DESIGN.md §1.5), started only from the user's tap
             on the Setup screen. dataSync on every API level (FOREGROUND_SERVICE_DATA_SYNC above); onTimeout pauses it. -->
        <service
            android:name=".data.models.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FileProvider for sharing generated game reports (PDF/PGN/PNG) out to other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- D2f: no network on the app's behalf at start. androidx.emoji2 (pulled in by Compose) registers an
             EmojiCompat initializer that, on the first Activity, asks Google Play services' font provider for
             "Noto Color Emoji Compat"; when GMS does not have it cached it DOWNLOADS it (about 3 MB from
             fonts.gstatic.com) and charges the traffic to this app's uid. Seen on chess36 in D2f:
             NoNetworkAfterSetupTest measured tx 30,966 B / rx ~3 MB for the app's uid while the FontLog said
             "Download finished for https://fonts.gstatic.com/...". The app does not need downloadable emoji
             (the system font renders what it shows), so the initializer is removed; the other startup
             initializers stay. Pinned by ManifestPermissionsTest (source) and NetworkPermissionTest (installed).
             MissingClass is ignored because androidx.startup is only on the runtime classpath (transitive). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

    </application>

</manifest>

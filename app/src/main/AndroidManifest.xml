<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to download the Stockfish NNUE net and check for engine updates. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Video export runs in VideoExportService, a started foreground service, so it survives the
      user leaving the video screen or backgrounding the app (a full review takes many minutes).

      targetSdk is 34 (see app/build.gradle.kts), so Android 14's typed-FGS rules apply: the
      service must declare a foregroundServiceType AND hold the matching typed permission, or
      startForeground() throws. `dataSync` is the applicable type at API 34 — the better-fitting
      `mediaProcessing` type and its permission were only added in API 35 and cannot be compiled
      against compileSdk 34.

      POST_NOTIFICATIONS is a runtime permission from API 33. It is requested opportunistically
      and the export never depends on it: denying it only hides the progress notification, the
      foreground service still runs to completion.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ChessAnalyzerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.ChessAnalyzer"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.ChessAnalyzer">

            <!-- App launcher entry -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- chess.com / Lichess "Share" -> plain text PGN -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Share of one or more PGN-ish files -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-chess-pgn" />
                <data android:mimeType="application/vnd.chess-pgn" />
                <data android:mimeType="text/x-chess-pgn" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-chess-pgn" />
                <data android:mimeType="application/vnd.chess-pgn" />
                <data android:mimeType="text/x-chess-pgn" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Opening a .pgn file from a file manager / Downloads / another app -->
            <intent-filter android:label="@string/open_pgn_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/x-chess-pgn" />
                <data android:scheme="content" android:mimeType="application/vnd.chess-pgn" />
                <data android:scheme="content" android:mimeType="text/x-chess-pgn" />
                <data android:scheme="file" android:mimeType="application/x-chess-pgn" />
                <data android:scheme="file" android:mimeType="application/vnd.chess-pgn" />
                <data android:scheme="file" android:mimeType="text/x-chess-pgn" />
            </intent-filter>

            <!-- Fallback: raw file:// / content:// URI ending in .pgn without a registered mime type -->
            <intent-filter android:label="@string/open_pgn_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="file"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.pgn" />
            </intent-filter>
            <intent-filter android:label="@string/open_pgn_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.pgn" />
            </intent-filter>
        </activity>

        <!-- Owns the MP4 export coroutine outside any Activity/composition. See the permission
             block above for why the type is dataSync rather than mediaProcessing. -->
        <service
            android:name=".video.VideoExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FileProvider for sharing generated game reports (PDF/PGN/PNG) out to other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>

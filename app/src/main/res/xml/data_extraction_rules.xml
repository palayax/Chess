<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ backup/transfer rules; mirrors backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="engine/" />
        <exclude domain="sharedpref" path="engine_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="engine/" />
    </device-transfer>
</data-extraction-rules>

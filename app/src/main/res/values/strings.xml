    <!-- Cloud voice setup wizard -->
    <string name="cloud_setup_title">Google Cloud voice</string>
    <string name="cloud_setup_intro">Higher-quality narration from Google Cloud Text-to-Speech, using your own Google account. This is optional: the on-device natural voice stays available and stays free.</string>
    <string name="cloud_setup_billing_header">Before you start: billing is required</string>
    <string name="cloud_setup_billing_body">Google only serves Text-to-Speech to a project that has a billing account with a payment method attached — even for free-tier use. If you would rather not add a card to your Google account, stop here; the on-device voice needs no account and no card.</string>
    <string name="cloud_setup_billing_cost">The free tier is %1$s characters a month for %2$s voices — about %3$d full game reviews. Anything beyond that, Google bills to you at $%4$d per million characters. New Google Cloud customers also get a $%5$d trial credit, which is a trial, not a free tier.</string>
    <string name="cloud_setup_pricing_link">Google\'s pricing page</string>
    <string name="cloud_setup_privacy">Your key is kept only on this device, encrypted with the Android Keystore, and is sent nowhere except Google\'s Text-to-Speech endpoint.</string>
    <string name="cloud_setup_step">Step %1$d</string>
    <string name="cloud_setup_step1_title">Create a Google Cloud project</string>
    <string name="cloud_setup_step1_body">Sign in with your Google account and create a project — any name will do. Using the Cloud Console itself is free.</string>
    <string name="cloud_setup_step2_title">Enable the Text-to-Speech API</string>
    <string name="cloud_setup_step2_body">Open the API\'s page with your new project selected and press Enable.</string>
    <string name="cloud_setup_step3_title">Enable billing on the project</string>
    <string name="cloud_setup_step3_body">Link a billing account with a payment method to the project. Required even to use the free tier (see above). The free allowance is applied automatically; nothing is charged until you exceed it.</string>
    <string name="cloud_setup_step4_title">Create an API key</string>
    <string name="cloud_setup_step4_body">Credentials → Create credentials → API key. Copy the key that appears.</string>
    <string name="cloud_setup_step5_title">Restrict the key (recommended)</string>
    <string name="cloud_setup_step5_body">On the same page, edit the key: under API restrictions choose "Restrict key" and tick Cloud Text-to-Speech API. Leave application restrictions at "None" — a website (HTTP referrer) restriction blocks requests from apps.</string>
    <string name="cloud_setup_step6_title">Paste the key and test it</string>
    <string name="cloud_setup_step6_body">Testing synthesizes two words ("%1$s") through the selected voice, %2$s. It is a real request, so a wrong key, a project without billing or a disabled API shows up here with an explanation — not halfway through an export.</string>
    <string name="cloud_setup_open_console">Open in Cloud Console</string>
    <string name="cloud_setup_key_label">API key</string>
    <string name="cloud_setup_key_show">Show</string>
    <string name="cloud_setup_key_hide">Hide</string>
    <string name="cloud_setup_test_and_save">Test and save</string>
    <string name="cloud_setup_testing">Checking the key with Google…</string>
    <string name="cloud_setup_saved">Key works: %1$s synthesized %2$d ms of audio. Cloud voice is now selected for narration — switch back in Settings any time.</string>
    <string name="cloud_setup_done">Done</string>

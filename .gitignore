local.properties
.gradle/
build/
*.keystore
*.jks
keystore.properties
.idea/
*.iml
vendor/Stockfish/
# Model files (~257 MB, downloaded by the app on first run since D2a): fetched for development, tests
# and publishing by scripts/fetch_models.sh, pinned by vendor/models/MODELS.lock. MODELS.lock IS
# committed, and so will be the manifest's public signing key (D2e); see the negations below.
vendor/models/*
!vendor/models/MODELS.lock
!vendor/models/manifest_public_key.der

# Private keys, e.g. keystore/models-signing.pem (signs the model manifest, D2e). Never commit; back up
# with the release keystore.
*.pem
.cxx/
**/.cxx/

# PC video producer (:desktop) — large local binaries, models, venvs and work dirs
pc/work/
pc/bin/
pc/models/
pc/tts/.venv/
pc/tts/hf_cache/
pc/tts/.venv-kokoro/
**/__pycache__/

# Final signed release APKs (R7)
dist/

# Local build tools, e.g. tools/bundletool-all-<version>.jar (D1; see docs/PUBLISHING.md)
tools/

# PC producer TTS model downloads (hundreds of MB, re-fetchable)
pc/tts/models/

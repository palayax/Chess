# Bundled model files (~257 MB): fetched by scripts/fetch_models.sh, pinned by vendor/models/MODELS.lock.
# MODELS.lock itself IS committed (see the negation below).
vendor/models/*
!vendor/models/MODELS.lock
.cxx/
**/.cxx/

